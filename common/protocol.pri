# ============================================================================
#  公共协议模块 —— 服务端(109-TcpServer)与客户端(120-TCPClient)共用同一份实现
#
#  在 .pro 里这样引用（$$PWD 保证是绝对路径，不受影子构建目录影响）：
#      include(../common/protocol.pri)
# ============================================================================

INCLUDEPATH += $$PWD

HEADERS += \
    $$PWD/protocol.h

SOURCES += \
    $$PWD/protocol.cpp
